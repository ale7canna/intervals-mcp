# intervals.icu → Settings → Developer Settings → API Key
INTERVALS_API_KEY=

# Optional: your athlete id (e.g. i123456). Auto-detected from the API key if omitted.
INTERVALS_ATHLETE_ID=

# Only for the remote HTTP deployment (api/mcp.ts): shared secret clients must present.
# Generate with `npm run token`. Password-equivalent — never commit it.
MCP_AUTH_TOKEN=
