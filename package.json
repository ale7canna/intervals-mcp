{
  "name": "intervals-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server for intervals.icu — read training data and create structured workouts that sync to Garmin",
  "type": "module",
  "bin": {
    "intervals-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "token": "node scripts/gen-token.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.6"
  }
}
